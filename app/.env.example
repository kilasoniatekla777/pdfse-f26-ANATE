# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Supabase -> Settings -> Database -> Connection string. Use the pooled (transaction) string on Vercel.
DATABASE_URL=

# PostHog -> Settings -> Project. EU cloud shown; use us.i.posthog.com for US.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Long random string; the salon's private bookings page is /<locale>/s/<slug>/admin/<this token>.
SALON_ADMIN_TOKEN=
